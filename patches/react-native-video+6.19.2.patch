+package com.brentvatne.exoplayer
+
+import android.content.Context
+import android.graphics.Bitmap
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.Paint
+import android.graphics.RectF
+import android.graphics.Typeface
+import android.os.Build
+import android.text.Layout
+import android.text.SpannableStringBuilder
+import android.text.Spanned
+import android.text.StaticLayout
+import android.text.TextPaint
+import android.text.style.BackgroundColorSpan
+import android.text.style.ForegroundColorSpan
+import android.util.AttributeSet
+import android.util.TypedValue
+import android.view.View
+import android.view.ViewGroup
+import androidx.media3.common.text.Cue
+import com.brentvatne.common.api.SubtitleStyle
+
+class CustomSubtitleOverlayView @JvmOverloads constructor(
+    context: Context,
+    attrs: AttributeSet? = null,
+    defStyleAttr: Int = 0
+) : View(context, attrs, defStyleAttr) {
+
+    private var cues: List<Cue> = emptyList()
+    private var style = SubtitleStyle()
+
+    private val textPaint = TextPaint(Paint.ANTI_ALIAS_FLAG).apply {
+        isSubpixelText = true
+    }
+    private val strokePaint = TextPaint(Paint.ANTI_ALIAS_FLAG).apply {
+        isSubpixelText = true
+        style = Paint.Style.STROKE
+        strokeJoin = Paint.Join.ROUND
+        strokeCap = Paint.Cap.ROUND
+    }
+    private val bgPaint = Paint(Paint.ANTI_ALIAS_FLAG)
+    private val bitmapPaint = Paint(Paint.ANTI_ALIAS_FLAG or Paint.FILTER_BITMAP_FLAG)
+
+    fun setCues(newCues: List<Cue>) {
+        this.cues = newCues
+        postInvalidate()
+    }
+
+    fun setStyle(newStyle: SubtitleStyle) {
+        this.style = newStyle
+        postInvalidate()
+    }
+
+    private fun createEdgeText(source: CharSequence): CharSequence {
+        if (source !is Spanned) return source
+        val spannable = SpannableStringBuilder(source)
+        val fgSpans = spannable.getSpans(0, spannable.length, ForegroundColorSpan::class.java)
+        for (span in fgSpans) {
+            spannable.removeSpan(span)
+        }
+        val bgSpans = spannable.getSpans(0, spannable.length, BackgroundColorSpan::class.java)
+        for (span in bgSpans) {
+            spannable.removeSpan(span)
+        }
+        return spannable
+    }
+
+    private fun cleanCueText(source: CharSequence): CharSequence {
+        if (source !is Spanned) return source
+        val spannable = SpannableStringBuilder(source)
+        val bgSpans = spannable.getSpans(0, spannable.length, BackgroundColorSpan::class.java)
+        for (span in bgSpans) {
+            spannable.removeSpan(span)
+        }
+        return spannable
+    }
+
+    private fun buildLayout(
+        text: CharSequence,
+        paint: TextPaint,
+        width: Int,
+        alignment: Layout.Alignment
+    ): StaticLayout =
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.M) {
+            StaticLayout.Builder.obtain(text, 0, text.length, paint, width)
+                .setAlignment(alignment)
+                .setLineSpacing(0f, 1.15f)
+                .setIncludePad(false)
+                .build()
+        } else {
+            @Suppress("DEPRECATION")
+            StaticLayout(text, paint, width, alignment, 1.15f, 0f, false)
+        }
+
+    private fun drawBitmapCue(
+        canvas: Canvas,
+        cue: Cue,
+        bitmap: Bitmap,
+        frameLeft: Float,
+        frameTop: Float,
+        frameWidth: Float,
+        frameHeight: Float
+    ) {
+        val width = if (cue.size != Cue.DIMEN_UNSET) cue.size * frameWidth
+            else bitmap.width.toFloat()
+        val height = if (cue.bitmapHeight != Cue.DIMEN_UNSET) cue.bitmapHeight * frameHeight
+            else width * bitmap.height / maxOf(1, bitmap.width)
+        val anchorX = frameLeft + (if (cue.position != Cue.DIMEN_UNSET) cue.position else 0.5f) * frameWidth
+        val anchorY = frameTop + (if (cue.line != Cue.DIMEN_UNSET) cue.line else 0.9f) * frameHeight
+        val left = when (cue.positionAnchor) {
+            Cue.ANCHOR_TYPE_START -> anchorX
+            Cue.ANCHOR_TYPE_END -> anchorX - width
+            else -> anchorX - width / 2f
+        }
+        val top = when (cue.lineAnchor) {
+            Cue.ANCHOR_TYPE_START -> anchorY
+            Cue.ANCHOR_TYPE_MIDDLE -> anchorY - height / 2f
+            else -> anchorY - height
+        }
+        canvas.drawBitmap(bitmap, null, RectF(left, top, left + width, top + height), bitmapPaint)
+    }
+
+    override fun onDraw(canvas: Canvas) {
